.{
    .name = .datastar_zig,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xa2c2b3996211dfe7,
    // BearSSL provides TLS termination for the built-in HTTP server. It is
    // optional: apps that run behind a proxy (the common case) never load it,
    // because `Config.tls` defaults to null. See `src/tls.zig`.
    //
    // Upstream BearSSL ships a Makefile rather than a build.zig, so this
    // wrapper supplies the build and fetches bearssl-0.6.tar.gz itself.
    // Pinned to a commit, not master, so the build cannot shift underneath us.
    //
    // The remaining dependencies exist only to build the example apps.
    .dependencies = .{
        .bearssl = .{
            .url = "https://github.com/tardy-org/bearssl-zig/archive/4b3e60ebe99fbf2bd1a38ebbd9e0d7369b7966ea.tar.gz",
            .hash = "bearssl-0.6.0-Shew4IhfAAAniElGD7Q6ssfo9jXl3XvnaA7T2adv6nhy",
        },
        // This is needed for those demo apps that require pub-sub
        .pubsub = .{
            .url = "git+https://github.com/zigster64/pubsub.zig#079bf4d94bfe40e91734a84fe418a3f18a0e73b4",
            .hash = "pubsub-0.0.0-6dy2AZOBAAB1zskJKRdIfdROfrVnp4XW3Rsjn-yPzoXN",
        },
        // This is needed for the example app that demonstrates how to use with http.zig
        .httpz = .{
            .url = "git+https://github.com/karlseguin/http.zig#250e208845249e41d48a996dbfb0ce18d2e82761",
            .hash = "httpz-0.0.0-PNVzrJwbCACCRQFU-_piWqJ_sXHCwxyp4HkHLAyY4msq",
        },
        // This is needed for the example app that demonstrates how to use with Dusty / zio
        .dusty = .{
            .url = "git+https://github.com/lalinsky/dusty#28a97b118bf1893a17a47fb77bf6529dd997ad99",
            .hash = "dusty-0.1.0-Qdw7RqYcCgBfokVHhdXJhX5a7vuSjNx2Yeg-xgcAWSmc",
        },
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=v0.11.0#53abdf9ce5e6279e29703a39180ce1cedd8ac4ca",
            .hash = "zio-0.11.0-xHbVVEqQGwDz0MYoQ0j7Ke0Y9E_iZVe5eLAWK4gd9U0i",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
